# Optional: setting API_TOKEN skips the setup wizard and bootstraps the
# instance with built-in default enums (legacy behavior).
# Leave empty to use the first-run setup page instead.
API_TOKEN=
AMAP_KEY=

# Host directory mounted for photo storage (default: ./photos).
# Set this to your own photo library path, e.g. /mnt/photos/hangar
# PHOTOS_DIR_HOST=./photos
